{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 300
    },
    "api/maintenance.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/analysis",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/index.html"
    },
    {
      "source": "/candidates",
      "destination": "/index.html"
    },
    {
      "source": "/reports",
      "destination": "/index.html"
    },
    {
      "source": "/reports/:analysisId",
      "destination": "/index.html"
    },
    {
      "source": "/system",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
